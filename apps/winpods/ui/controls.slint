// Small building blocks in the Windows 11 style: settings cards, status pill, level
// meter, segmented selector, icon button, info bar.
//
// Everything here is drawn the same by the software renderer (the default) and the
// GPU one: no drop shadows, no gradients on rounded shapes and no clipping that
// relies on rounded corners, none of which the software renderer supports.

import { Switch } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { StatusKind } from "state.slint";

// Background and outline shared by every card.
export component CardFrame inherits Rectangle {
    background: Theme.card-bg;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-border;
}

// A card that stacks its children vertically.
export component Card inherits CardFrame {
    in property <length> pad: Theme.card-padding;
    in property <length> gap: 12px;
    VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

// Section heading above a group of cards.
export component SectionTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 20px;
    padding-bottom: 4px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.body;
        font-weight: 600;
        accessible-role: AccessibleRole.text;
    }
}

// Caption (12 px) in the secondary text colour.
export component Caption inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.caption;
    wrap: word-wrap;
}

// Windows 11 settings card: title and description on the left, controls on the right.
export component SettingRow inherits CardFrame {
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;
    min-height: 64px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            // Single lines: layouts here do not grow for wrapped text, so elide instead.
            Text {
                text: root.title;
                color: root.enabled ? Theme.text : Theme.text-tertiary;
                font-size: Theme.body;
                overflow: elide;
            }
            if root.description != "": Caption {
                text: root.description;
                color: root.enabled ? Theme.text-secondary : Theme.text-tertiary;
                wrap: no-wrap;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 8px;
                @children
            }
        }
    }
}

// A setting with an On/Off toggle.
export component SwitchRow inherits SettingRow {
    in-out property <bool> checked;
    callback toggled(bool);
    Text {
        text: toggle.checked ? "On" : "Off";
        color: root.enabled ? Theme.text : Theme.text-tertiary;
        vertical-alignment: center;
        horizontal-alignment: right;
        min-width: 24px;
    }
    toggle := Switch {
        enabled: root.enabled;
        checked <=> root.checked;
        accessible-label: root.title;
        toggled => {
            root.toggled(self.checked);
        }
    }
}

// State colours for a StatusKind.
global Tones {
    public pure function fill(kind: StatusKind) -> color {
        if kind == StatusKind.ok {
            return Theme.ok;
        }
        if kind == StatusKind.busy {
            return Theme.busy;
        }
        if kind == StatusKind.error {
            return Theme.error;
        }
        return Theme.idle;
    }

    public pure function text(kind: StatusKind) -> color {
        if kind == StatusKind.ok {
            return Theme.ok-text;
        }
        if kind == StatusKind.busy {
            return Theme.busy-text;
        }
        if kind == StatusKind.error {
            return Theme.error-text;
        }
        return Theme.idle-text;
    }
}

// Rounded status chip with a coloured dot (pulses while connecting).
export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <StatusKind> kind;
    height: 24px;
    border-radius: self.height / 2;
    background: Tones.fill(root.kind).with-alpha(Theme.dark ? 0.20 : 0.13);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 11px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tones.fill(root.kind);
                opacity: root.kind == StatusKind.busy ? 0.55 + 0.45 * sin(animation-tick() / 2.5ms * 1deg) : 1.0;
            }
        }
        Text {
            text: root.text;
            color: Tones.text(root.kind);
            font-size: Theme.caption;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Soft shadow under a floating surface, built from translucent rounded layers (the
// software renderer draws no drop shadows). Put it right before the surface, with the
// same geometry. Sixteen layers 1px apart fade it linearly over 16px, in steps too
// fine to show as bands.
export component SoftShadow inherits Rectangle {
    in property <length> radius: Theme.radius;
    in property <length> offset-y: 8px;
    /// Opacity right at the surface's edge.
    in property <float> strength: 0.1;
    for spread in [16px, 15px, 14px, 13px, 12px, 11px, 10px, 9px, 8px, 7px, 6px, 5px, 4px, 3px, 2px, 1px]: Rectangle {
        x: -spread;
        y: -spread + root.offset-y;
        width: root.width + 2 * spread;
        height: root.height + 2 * spread;
        border-radius: root.radius + spread;
        background: #000000.with-alpha(root.strength / 16);
    }
}

// Square tile with the speaker glyph, tinted with the connection state.
export component SpeakerTile inherits Rectangle {
    in property <StatusKind> kind;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: Tones.fill(root.kind);
    animate background { duration: 250ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 30px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.speaker-body;
        fill: white;
        stroke: transparent;
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 30px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.speaker-waves;
        fill: transparent;
        stroke: white;
        stroke-width: 2px;
        stroke-line-cap: round;
    }
}

// Horizontal level meter. Its colour bands are fixed to the track (green, amber from
// 75 %, red from 90 %), so colours mark levels; each band is a solid piece rounded
// only at the bar's two ends.
export component LevelMeter inherits Rectangle {
    in property <float> level;
    property <float> shown: clamp(root.level, 0, 1);
    property <float> amber-from: 0.75;
    property <float> red-from: 0.9;
    property <length> end-radius: root.height / 2;
    height: 6px;
    border-radius: root.end-radius;
    background: Theme.meter-track;
    accessible-role: progress-indicator;
    accessible-value: round(root.shown * 100) + "%";
    Rectangle {
        visible: root.shown > 0;
        x: 0;
        width: min(root.shown, root.amber-from) * root.width;
        height: root.height;
        border-top-left-radius: min(root.end-radius, self.width / 2);
        border-bottom-left-radius: self.border-top-left-radius;
        border-top-right-radius: root.shown <= root.amber-from ? self.border-top-left-radius : 0;
        border-bottom-right-radius: self.border-top-right-radius;
        background: #2eaa4a;
    }
    Rectangle {
        visible: root.shown > root.amber-from;
        x: root.amber-from * root.width;
        width: max(0, min(root.shown, root.red-from) - root.amber-from) * root.width;
        height: root.height;
        border-top-right-radius: root.shown <= root.red-from ? min(root.end-radius, self.width) : 0;
        border-bottom-right-radius: self.border-top-right-radius;
        background: #e0a000;
    }
    Rectangle {
        visible: root.shown > root.red-from;
        x: root.red-from * root.width;
        width: max(0, root.shown - root.red-from) * root.width;
        height: root.height;
        border-top-right-radius: min(root.end-radius, self.width);
        border-bottom-right-radius: self.border-top-right-radius;
        background: #d04040;
    }
}

// Segmented selector (like a row of radio buttons).
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> selected;
    callback activated(int);
    height: 32px;
    border-radius: Theme.control-radius + 2px;
    background: Theme.subtle-fill;
    border-width: 1px;
    border-color: Theme.dark ? #ffffff0d : #0000000f;
    accessible-role: tab-list;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for item[index] in root.items: Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.control-radius;
            background: index == root.selected ? Theme.accent : touch.pressed ? Theme.subtle-fill : touch.has-hover ? Theme.subtle-fill-hover : transparent;
            accessible-role: tab;
            accessible-label: item;
            accessible-checked: index == root.selected;
            accessible-action-default => {
                root.activated(index);
            }
            Text {
                text: item;
                color: index == root.selected ? Theme.accent-foreground : Theme.text;
                font-size: 13px;
                font-weight: index == root.selected ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.activated(index);
                }
            }
        }
    }
}

// Borderless square button with a stroked path icon.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: Theme.control-radius;
    background: touch.pressed ? Theme.subtle-fill : touch.has-hover ? Theme.subtle-fill-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.icon;
        fill: transparent;
        stroke: Theme.text;
        stroke-width: 1.3px;
        stroke-line-cap: round;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Accent-coloured clickable text.
export component Link inherits Text {
    callback clicked;
    color: touch.has-hover ? Theme.accent : Theme.accent;
    font-size: Theme.body;
    accessible-role: button;
    accessible-action-default => {
        root.clicked();
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Informational banner (Windows 11 InfoBar) with action buttons as children.
export component InfoBar inherits Rectangle {
    in property <string> title;
    in property <string> message;
    background: Theme.dark ? #1f2c3a : #e8f1fb;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.dark ? #2b3d50 : #cde0f4;
    accessible-role: groupbox;
    accessible-label: root.title;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.accent;
                    Path {
                        width: 14px;
                        height: 14px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: Icons.download;
                        fill: transparent;
                        stroke: Theme.accent-foreground;
                        stroke-width: 1.6px;
                        stroke-line-cap: round;
                    }
                }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.message != "": Caption {
                    text: root.message;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
}
