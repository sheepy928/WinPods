// A ComboBox that reports each time its list opens.
//
// The main page re-enumerates the audio devices whenever the Source list opens, so a
// device plugged in while the window is up shows up the next time the user opens the
// list. The plain ComboBox has no "opened" callback, and its `has-focus` is no
// substitute: it stays true after the popup closes (a row picked, Escape, a click
// outside), so a focus rule fires only on the first opening.
//
// Every std-widgets style binds `accessible-expanded` to "the popup is open and has
// focus", whether a click, Return or a screen reader's expand action opened it, so
// `opened` fires on each opening and on nothing else.

import { ComboBox } from "std-widgets.slint";

export component OpenAwareComboBox inherits ComboBox {
    // The list has just opened (fires once per opening).
    callback opened();

    changed accessible-expanded => {
        if self.accessible-expanded {
            root.opened();
        }
    }
}
