// Windows 11 look: Mica-like page background, layered cards, Segoe UI type ramp.
// Follows Palette.color-scheme, which tracks the system theme unless forced.

import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // surfaces
    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #ffffff;
    out property <color> card-bg-hover: dark ? #323232 : #f9f9f9;
    out property <color> card-border: dark ? #1c1c1c : #e5e5e5;
    out property <color> subtle-fill: dark ? #ffffff0f : #0000000a;
    out property <color> subtle-fill-hover: dark ? #ffffff15 : #00000010;
    out property <color> divider: dark ? #ffffff14 : #0000000f;
    out property <color> scrim: dark ? #0000008c : #0000004d;

    // text
    out property <color> text: dark ? #ffffff : #1b1b1b;
    out property <color> text-secondary: dark ? #c9c9c9 : #5f5f5f;
    out property <color> text-tertiary: dark ? #9d9d9d : #8a8a8a;
    out property <brush> accent: Palette.accent-background;
    out property <brush> accent-foreground: Palette.accent-foreground;

    // state colours (same hues as the tray icons)
    out property <color> ok: #2eaa4a;
    out property <color> busy: #e0a000;
    out property <color> error: #d04040;
    out property <color> idle: #8a8a8a;
    out property <color> ok-text: dark ? #6ccb5f : #0f7b0f;
    out property <color> busy-text: dark ? #fce100 : #9d5d00;
    out property <color> error-text: dark ? #ff99a4 : #c42b1c;
    out property <color> idle-text: dark ? #c9c9c9 : #5f5f5f;
    out property <color> warning-text: dark ? #fce100 : #9d5d00;

    // meter
    out property <color> meter-track: dark ? #ffffff17 : #0000000f;

    // type ramp (Windows 11)
    out property <length> caption: 12px;
    out property <length> body: 14px;
    out property <length> subtitle: 20px;
    out property <length> title: 28px;

    // metrics
    out property <length> radius: 8px;
    out property <length> control-radius: 4px;
    out property <length> page-padding: 20px;
    out property <length> card-padding: 16px;
    out property <length> card-gap: 4px;
    out property <length> section-gap: 24px;
}

// Path data for the few icons the window uses (outline style, 20x20 viewbox unless
// noted).
export global Icons {
    out property <string> gear: "M7.72 3.38 L8.40 0.94 L11.60 0.94 L12.28 3.38 L13.07 3.71 L15.28 2.46 L17.54 4.72 L16.29 6.93 L16.62 7.72 L19.06 8.40 L19.06 11.60 L16.62 12.28 L16.29 13.07 L17.54 15.28 L15.28 17.54 L13.07 16.29 L12.28 16.62 L11.60 19.06 L8.40 19.06 L7.72 16.62 L6.93 16.29 L4.72 17.54 L2.46 15.28 L3.71 13.07 L3.38 12.28 L0.94 11.60 L0.94 8.40 L3.38 7.72 L3.71 6.93 L2.46 4.72 L4.72 2.46 L6.93 3.71 Z M12.6 10 A2.6 2.6 0 1 1 7.4 10 A2.6 2.6 0 1 1 12.6 10 Z";
    out property <string> back: "M9 4 L3 10 L9 16 M3.5 10 L17 10";
    out property <string> download: "M10 3.5 L10 12.5 M6 8.5 L10 12.5 L14 8.5 M4.5 16 L15.5 16";
    // 24x24 viewbox: speaker body + cone (filled) and two waves (stroked).
    out property <string> speaker-body: "M4 9.25 L7.5 9.25 L12 5.5 L12 18.5 L7.5 14.75 L4 14.75 Z";
    out property <string> speaker-waves: "M14.75 9 A4 4 0 0 1 14.75 15 M17.25 6.25 A7.5 7.5 0 0 1 17.25 17.75";
}
